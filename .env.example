# Optional overrides for local development only; Compose also supplies these defaults.
DJANGO_SECRET_KEY=local-demo-only-not-for-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=order_to_audit
POSTGRES_USER=order_to_audit
POSTGRES_PASSWORD=local-demo-password
# Optional: alternate local port and initial demo password (existing passwords are retained).
WEB_PORT=8000
DEMO_PASSWORD=DemoPass123!
